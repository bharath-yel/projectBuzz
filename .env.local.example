# Copy this file to .env.local and fill in the values. .env.local is gitignored.

# Supabase project URL (Supabase dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key. Safe for the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute base URL of the site, no trailing slash.
# Local: http://localhost:3000. Production: the custom domain.
NEXT_PUBLIC_SITE_URL=
